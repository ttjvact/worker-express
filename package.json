{
  "name": "worker-express",
  "version": "0.2.0",
  "description": "Express-like routing for Cloudflare Workers",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "homepage": "https://github.com/ttjvact/worker-express",
  "bugs": {
    "url": "https://github.com/ttjvact/worker-express/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ttjvact/worker-express.git"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "docs"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev:hello": "npm run build && wrangler dev --config examples/hello-world/wrangler.jsonc",
    "test": "npm run build && node --test test/app.test.js test/middleware.test.js test/miniflare.test.js",
    "test:integration": "npm run build && node --test test/miniflare.test.js",
    "test:unit": "npm run build && node --test test/app.test.js test/middleware.test.js",
    "lint": "node scripts/lint.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "types": "dist/index.d.ts",
  "devDependencies": {
    "miniflare": "^4.20260401.0",
    "typescript": "^5.9.3",
    "wrangler": "^4.80.0"
  }
}
